{
  "__inputs": [],
  "__requires": [],
  "title": "MVNO NOC — Unified Carrier Operations & AI Dashboard",
  "uid": "mvno-unified-noc",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": true,
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "mvno",
    "carrier:5g-sa",
    "ai:vosk-asr",
    "component:unified",
    "noc",
    "3gpp"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "timezone": "browser",
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ 1. CARRIER KPI HERO OVERVIEW",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#00F2FE" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#00F2FE", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "sum(mvno_call_requests_total) default 0", "refId": "A" }],
      "title": "Total Voice Call Requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#7928CA" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#7928CA", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "sum(mvno_sms_requests_total) default 0", "refId": "A" }],
      "title": "Total SMS Requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#4FACFE" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#4FACFE", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "sum(mvno_vosk_transcriptions_total) default 0", "refId": "A" }],
      "title": "Vosk ASR Transcriptions",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00E676", "value": null },
              { "color": "#FF9100", "value": 1 },
              { "color": "#FF0844", "value": 5 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "sum(mvno_vosk_flagged_total) default 0", "refId": "A" }],
      "title": "Scam Keyword Flags",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#FF0844" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#FF0844", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "(sum(mvno_sms_blocked_total) + sum(mvno_call_blocked_total)) default 0", "refId": "A" }],
      "title": "Total Blocked Threats",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "#FF0844", "text": "OFFLINE" }, "1": { "color": "#00E676", "text": "ONLINE (READY)" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#FF0844", "value": null }, { "color": "#00E676", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "mvno_vosk_model_ready default 1", "refId": "A" }],
      "title": "Vosk JNI Engine State",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "🤖 2. REAL-TIME VOSK ASR & AI PHISHING INTELLIGENCE",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "opacity", "lineWidth": 1 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 201,
      "options": {
        "displayMode": "gradient",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "topk(10, sum by (word) (mvno_vosk_scamflag_total))",
          "legendFormat": "Scam Keyword: {{word}}",
          "refId": "A"
        }
      ],
      "title": "Top Detected Phishing & Scam Keywords (ASR Lattice)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 202,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_vosk_transcriptions_total[1m]) default 0",
          "legendFormat": "ASR Speech Transcription Rate",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_vosk_classified_total[1m]) default 0",
          "legendFormat": "AI Classifier Throughput",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_vosk_flagged_total[1m]) default 0",
          "legendFormat": "Phishing Detection Rate",
          "refId": "C"
        }
      ],
      "title": "ASR Speech-to-Text & AI Classification Velocity",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 300,
      "title": "🛡️ 3. SECURITY & ANTI-FRAUD DECISION PIPELINE",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 301,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_sms_requests_total[1m]) default 0",
          "legendFormat": "SMS Total Ingress",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_sms_blocked_total[1m]) default 0",
          "legendFormat": "SMS Blocked (Phishing/Spam)",
          "refId": "B"
        }
      ],
      "title": "SMS Interception & AI Filtering Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 302,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_call_requests_total[1m]) default 0",
          "legendFormat": "Voice Call Total Ingress",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_call_blocked_total[1m]) default 0",
          "legendFormat": "Voice Call Blocked",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(mvno_call_blocked_eir_total[1m]) default 0",
          "legendFormat": "EIR SIM-Swap Intercepted",
          "refId": "C"
        }
      ],
      "title": "Voice Call Interception & EIR Defense Throughput",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 400,
      "title": "🎙️ 4. 3GPP MULTI-PARTY CONFERENCING & RTP MEDIA PLANE",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 401,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rtpengine_current_sessions default 0",
          "legendFormat": "Active RTP Media Sessions",
          "refId": "A"
        }
      ],
      "title": "Active RTPEngine Media Sessions",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 402,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(rtpengine_packet_count_total[1m]) default 0",
          "legendFormat": "RTP Packet Ingress/Egress",
          "refId": "A"
        }
      ],
      "title": "RTP Packet Flow (G.711u / PCMU 8kHz)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00E676", "value": null },
              { "color": "#FF0844", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 403,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rtpengine_zero_packet_streams default 0",
          "refId": "A"
        }
      ],
      "title": "Zero-Packet RTP Streams (Media Stalled Watchdog)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 500,
      "title": "🖥️ 5. CARRIER NETWORK FUNCTIONS & INFRASTRUCTURE HEALTH",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "#FF0844", "text": "DOWN" }, "1": { "color": "#00E676", "text": "HEALTHY (UP)" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#FF0844", "value": null }, { "color": "#00E676", "value": 1 }] }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "id": 501,
      "options": {
        "displayMode": "gradient",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "up",
          "legendFormat": "Service Instance: {{job}} ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "Carrier Telecom & AI Microservices Liveness (up)",
      "type": "bargauge"
    }
  ]
}