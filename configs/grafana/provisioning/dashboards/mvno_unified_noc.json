      "id": 106,
      "options": {
        "content": "<div style=\"display: flex; flex-direction: column; gap: 10px; padding: 10px; background: rgba(15,23,42,0.6); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);\">\n  <div style=\"font-size: 12px; color: rgba(255,255,255,0.7);\">VOICE PATH \u2014 SipClient (SIP 5066)</div>\n  <div style=\"display: flex; align-items: center; justify-content: space-around;\">\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(0,242,254,0.15), rgba(0,242,254,0.05)); border:1px solid #00F2FE; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\udcde</div><div style=\"font-weight:bold; color:#00F2FE; font-size:13px;\">SipClient UA</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">SIP RFC 3261 \u00b7 5066:5060/udp</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(121,40,202,0.15), rgba(121,40,202,0.05)); border:1px solid #7928CA; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\udce1</div><div style=\"font-weight:bold; color:#7928CA; font-size:13px;\">Kamailio SIP Proxy</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">REGISTER+INVITE 407 digest \u00b7 INTERCEPT callout</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(255,145,0,0.15), rgba(255,145,0,0.05)); border:1px solid #FF9100; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\udee1\ufe0f</div><div style=\"font-weight:bold; color:#FF9100; font-size:13px;\">Telecom Gateway</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">Spring Boot \u00b7 X-API-Key \u00b7 OCS \u00b7 EIR</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(0,230,118,0.15), rgba(0,230,118,0.05)); border:1px solid #00E676; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83e\udd16</div><div style=\"font-weight:bold; color:#00E676; font-size:13px;\">AI Classifier</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">POST /api/v1/classify \u00b7 SLA fail-open</div>\n    </div>\n  </div>\n  <div style=\"font-size:12px; color:rgba(255,255,255,0.7);\">SMS PATH \u2014 sms-client (SMPP 3.4)</div>\n  <div style=\"display: flex; align-items: center; justify-content: space-around;\">\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(0,230,118,0.12), rgba(0,230,118,0.04)); border:1px solid #00E676; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\udcac</div><div style=\"font-weight:bold; color:#00E676; font-size:13px;\">sms-client ESME</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">SMPP 3.4 \u00b7 deliver_sm</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(0,242,254,0.12), rgba(0,242,254,0.04)); border:1px solid #00F2FE; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\uddc4\ufe0f</div><div style=\"font-weight:bold; color:#00F2FE; font-size:13px;\">OsmoSMSC</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">SMPP 2775 \u00b7 hold &amp; verify</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(255,145,0,0.12), rgba(255,145,0,0.04)); border:1px solid #FF9100; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\udee1\ufe0f</div><div style=\"font-weight:bold; color:#FF9100; font-size:13px;\">Telecom Gateway</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">POST /intercept/sms + X-API-Key</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(0,230,118,0.12), rgba(0,230,118,0.04)); border:1px solid #00E676; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83e\udd16</div><div style=\"font-weight:bold; color:#00E676; font-size:13px;\">AI Classifier</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">POST /api/v1/classify</div>\n    </div>\n  </div>\n  <div style=\"font-size:12px; color:rgba(255,255,255,0.7);\">5G RADIO TRACK \u2014 registration only (voice/SMS are external-path demos; SMS-over-NAS on roadmap)</div>\n  <div style=\"display: flex; align-items: center; justify-content: space-around;\">\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(121,40,202,0.12), rgba(121,40,202,0.04)); border:1px solid #7928CA; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\ud83d\udcf1</div><div style=\"font-weight:bold; color:#7928CA; font-size:13px;\">UERANSIM</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">gNB + 3 UEs \u00b7 ran_ue gauge</div>\n    </div>\n    <div style=\"color:#00F2FE; font-size:16px;\">\u2794</div>\n    <div style=\"flex:1; margin:0 6px; padding:10px; background: linear-gradient(135deg, rgba(121,40,202,0.12), rgba(121,40,202,0.04)); border:1px solid #7928CA; border-radius:10px; text-align:center;\">\n      <div style=\"font-size:20px;\">\u2699\ufe0f</div><div style=\"font-weight:bold; color:#7928CA; font-size:13px;\">Open5GS 5GC</div><div style=\"font-size:11px; color:rgba(255,255,255,0.6);\">AMF \u00b7 SMF \u00b7 UPF \u00b7 NRF \u2014 NGAP 38412 \u00b7 PFCP 8805</div>\n    </div>\n  </div>\n</div>",
        "mode": "html"
      },
