    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "id": 6,
      "title": "\ud83c\udf0a Real-Time RTP Media Stream Bandwidth (Bytes/s)",
      "description": "Real-time G.711u / Opus audio stream throughput bridged through RTPEngine.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 18,
            "lineWidth": 2
          },
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bandwidth"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#00E676",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(rtpengine_bytes_total[$__rate_interval]) default 0",
          "legendFormat": "Bandwidth",
          "refId": "A"
        }
      ]
    },
