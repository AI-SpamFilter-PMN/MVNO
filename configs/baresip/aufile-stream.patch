+static int read_file(struct ausrc_st *st);   /* MVNO patch: fwd decl for file_thread */
+
+/* Live-stream file reader thread (MVNO patch): keeps topping up the aubuf
+   from the growing WAV file. read_file() returns only on error or teardown,
+   so this loop is exited via the run flag. */
+static int file_thread(void *arg)
+{
+	struct ausrc_st *st = arg;
+
+	while (re_atomic_rlx(&st->run))
+		read_file(st);
+
+	return 0;
+}
+
+
+
+/* MVNO patch: detect a "live" (growing) WAV stream. The host live-mic feeder
+   writes a WAV header with an UNKNOWN data chunk size (0xFFFFFFFF) so that
+   aufile keeps reading the ever-growing file. A finite file (callee leg) has
+   a real data size and must stop at EOF. Returns true if the data chunk size
+   is 0xFFFFFFFF (live stream). */
+/* MVNO patch: read a little-endian uint32 from a WAV chunk header (portable —
+   WAV sizes are LE; do not assume host endianness). */
+static uint32_t aufile_read_le32(FILE *f)
+{
+	uint8_t b[4];
+
+	if (1 != fread(b, sizeof(b), 1, f))
+		return 0;
+
+	return (uint32_t)b[0] | ((uint32_t)b[1] << 8) |
+	       ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+}
+
+/* MVNO patch: detect a "live" (growing) WAV stream. The host live-mic feeder
+   writes a WAV header with an UNKNOWN data chunk size (0xFFFFFFFF) so that
+   aufile keeps reading the ever-growing file. A finite file (callee leg) has
+   a real data size and must stop at EOF. Returns true if the data chunk size
+   is 0xFFFFFFFF (live stream). */
+static bool aufile_is_live(const char *dev)
+{
+	FILE *f;
+	uint8_t id[4];
+	uint32_t sz;
+	bool live = false;
+
+	f = fopen(dev, "rb");
+	if (!f)
+		return false;
+
+	/* skip RIFF header + WAVE + fmt chunk (fixed 12 + 8 + 16 bytes) */
+	if (fseek(f, 12, SEEK_SET))
+		goto out;
+	if (1 != fread(id, sizeof(id), 1, f))
+		goto out;
+	if (memcmp(id, "fmt ", 4))
+		goto out;
+	sz = aufile_read_le32(f);
+	/* skip fmt payload + any extra */
+	if (fseek(f, sz, SEEK_CUR))
+		goto out;
+
+	/* scan chunks for "data" */
+	for (;;) {
+		if (1 != fread(id, sizeof(id), 1, f))
+			goto out;
+		sz = aufile_read_le32(f);
+		if (0 == memcmp(id, "data", 4)) {
+			live = (sz == 0xFFFFFFFFu);
+			break;
+		}
+		if (fseek(f, sz, SEEK_CUR))
+			goto out;
+	}
+
+ out:
+	fclose(f);
+	return live;
+}
