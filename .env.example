# ============================================================================
# MVNO — environment secrets template. NEVER commit real values.
# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# ============================================================================

# sms-client / Filteration-System shared Neon (Postgres) history database.
# ROW-ONLY policy: we add/read rows with the EXISTING schema only — never
# CREATE/ALTER/DROP, never change the ERD (db/schema.sql lives in the
# sms-client repo). Message bodies + transcripts are intentionally NOT stored —
# only classification metadata.
# Format: postgresql://<user>:<password>@<host>:5432/neondb?sslmode=require&channel_binding=require
NEON_DB_URL="postgresql://<user>:<password>@<host>/neondb?sslmode=require&channel_binding=require"

# Local Neon clone (read-only pg_dump source) — used by scripts/neon/clone.sh
# to mirror production schema+data locally. Pipeline writes to NEON_DB_LOCAL_URL.
NEON_DB_LOCAL_URL="postgresql://mvno:mvno@localhost:5433/neondb"

# Vosk model selection for bootstrap.sh: large (vosk-model-en-us-0.22, default) or small (vosk-model-small-en-us-0.15)
VOSK_MODEL=large