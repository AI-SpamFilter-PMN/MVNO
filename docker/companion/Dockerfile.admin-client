# ==============================================================================
# Dockerfile.admin-client — Web Admin Dashboard (Java 17 + Embedded Tomcat)
# ==============================================================================

FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /build
COPY pom.xml .
RUN mvn dependency:go-offline -B || true
COPY src ./src
RUN mvn clean package -DskipTests -B

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/target/*.jar app.jar

ENV PORT=8082
ENV DB_URL=postgresql://mvno:mvno@mvno-neon-local:5432/neondb

EXPOSE 8082

ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-Ddb.url=postgresql://mvno:mvno@mvno-neon-local:5432/neondb", "-jar", "app.jar"]
